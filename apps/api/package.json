{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "start": "vite-node src/main.ts",
    "build": "echo 'api runs via vite-node (SWC decorators); see README in report'",
    "lint": "echo ok",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "vitest run test/isolation",
    "seed": "vite-node src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@casl/ability": "^6.7.2",
    "@cbt/abilities": "workspace:*",
    "@cbt/config": "workspace:*",
    "@cbt/contracts": "workspace:*",
    "@cbt/db": "workspace:*",
    "@cbt/marking": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.7.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "papaparse": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.0",
    "vite": "^5.4.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  }
