# Copy to .env (or export in your shell). Every value below is the local-development default,
# so the stack runs without a .env file. All apps read this through packages/config (loadEnv).
# Production: set real secrets in your host's environment, never commit them.

NODE_ENV=development

# --- API (apps/api) -------------------------------------------------------------------------------------------------
PORT=4000
DATABASE_URL=postgres://cbt:cbt@localhost:5432/cbt     # owner connection (migrations, auth, worker)
VALKEY_URL=redis://localhost:6379                       # BullMQ queues
QUEUE_DRIVER=bullmq                                     # "inline" runs jobs in-process (tests)

# Better Auth. BETTER_AUTH_SECRET must be 16+ chars and is REQUIRED (not the dev default) when NODE_ENV=production.
BETTER_AUTH_SECRET=change-me-to-32+-random-chars-please
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Platform owner created by `pnpm --filter api seed`
SUPER_ADMIN_EMAIL=owner@cbt.local
SUPER_ADMIN_PASSWORD=ChangeMe!12345

# --- Object storage (S3 API; SeaweedFS in docker-compose) -----------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=cbt
S3_ACCESS_KEY=any
S3_SECRET_KEY=any

# --- Other services -------------------------------------------------------------------------------------------------
GOTENBERG_URL=http://localhost:3100                     # HTML -> PDF reports
SMTP_URL=smtp://localhost:1025                          # Mailpit in dev

# --- Web (apps/web) -------------------------------------------------------------------------------------------------
# API_ORIGIN is where the Next.js server proxies /api/*; NEXT_PUBLIC_API_URL is empty for same-origin calls.
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=
AUTH_REQUIRED=1
# NEXT_PUBLIC_DEMO=1 builds the backend-less hosted demo (see README "Hosted demo").
